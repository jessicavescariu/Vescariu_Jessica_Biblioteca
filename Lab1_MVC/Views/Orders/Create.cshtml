
@model Lab1_MVC.Models.Order

@{
    ViewData["Title"] = "Create Order";
}

<h1>Create Order</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="CustomerID">Customer</label>
                <select asp-for="CustomerID" asp-items="ViewBag.CustomerID" class="form-control">
                    <option value="">Select customer</option>
                </select>
            </div>

            <div class="form-group">
                <label asp-for="BookID">Book</label>
                <select asp-for="BookID" asp-items="ViewBag.BookID" class="form-control">
                    <option value="">Select book</option>
                </select>
            </div>

            <div class="form-group">
                <label asp-for="OrderDate">Order Date</label>
                <input asp-for="OrderDate" type="date" class="form-control" />
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
