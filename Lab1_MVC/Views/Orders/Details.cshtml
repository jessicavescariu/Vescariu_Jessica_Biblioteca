
@model Lab1_MVC.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<h1>Order Details</h1>

<hr />

<dl class="row">
    <dt class="col-sm-2">Customer</dt>
    <dd class="col-sm-10">@Model.Customer.Name</dd>

    <dt class="col-sm-2">Book</dt>
    <dd class="col-sm-10">@Model.Book.Title</dd>

    <dt class="col-sm-2">Order Date</dt>
    <dd class="col-sm-10">@Model.OrderDate.ToShortDateString()</dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.ID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
