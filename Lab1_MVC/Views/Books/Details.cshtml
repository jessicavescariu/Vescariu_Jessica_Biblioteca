
@model Lab1_MVC.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<h1>Details</h1>

<div>
    <h4>Book</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Title)</dd>

        <dt class="col-sm-2">Author</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Author.FullName)</dd>

        <dt class="col-sm-2">Genre</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Genre.Name)</dd>

        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Price)</dd>
    </dl>
</div>

<div>
    <h4>Orders</h4>
    <hr />

    <table class="table">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Order Date</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var order in Model.Orders.OrderByDescending(o => o.OrderDate))
        {
            <tr>
                <td>@order.Customer.Name</td>
                <td>@order.OrderDate.ToShortDateString()</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.ID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
