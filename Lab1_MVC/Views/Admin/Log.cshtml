
@model Lab1_MVC.Models.PaginatedList<Lab1_MVC.Models.RecommendationLog>

@{
    ViewData["Title"] = "Jurnal recomandări";
}

<h1>Jurnal recomandări</h1>

<form method="get" asp-action="Log" class="mb-3">
    <label>Cititor:</label>
    <input type="number" name="readerId" value="@ViewBag.ReaderId" />

    <label>De la:</label>
    <input type="date" name="from" value="@ViewBag.From" />

    <label>Până la:</label>
    <input type="date" name="to" value="@ViewBag.To" />

    <button type="submit" class="btn btn-primary">Filtrează</button>
</form>

<a asp-action="Log" asp-route-sortOrder="oldest">
    Cele mai vechi primele
</a>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Cititor</th>
            <th>Data</th>
            <th>Cărți recomandate</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.ID</td>
                <td>@log.ReaderId</td>
                <td>@log.CreatedAt</td>
                <td>@log.BookIds</td>
            </tr>
        }
    </tbody>
</table>

<p>Pagina @Model.PageIndex din @Model.TotalPages</p>

<a asp-action="Log" asp-route-pageNumber="@(Model.PageIndex - 1)"
   class="btn btn-outline-primary"
   aria-disabled="@(!Model.HasPreviousPage)">
    Anterior
</a>

<a asp-action="Log" asp-route-pageNumber="@(Model.PageIndex + 1)"
   class="btn btn-outline-primary"
   aria-disabled="@(!Model.HasNextPage)">
    Următor
</a>
